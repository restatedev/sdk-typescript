{
  "name": "@restatedev/restate-sdk-integration-client",
  "version": "1.18.0",
  "description": "Client for the Restate ingress integration (ingestion) API",
  "author": "Restate Developers",
  "email": "code@restate.dev",
  "license": "MIT",
  "homepage": "https://github.com/restatedev/sdk-typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/restatedev/sdk-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/restatedev/sdk-typescript/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "turbo run _test --filter={.}...",
    "_test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "generate:proto": "buf generate",
    "build": "turbo run _build --filter={.}...",
    "_build": "tsc --noEmit && tsdown",
    "dev": "tsc --noEmit --watch",
    "clean": "rm -rf dist *.tsbuildinfo .turbo",
    "check:types": "turbo run _check:types --filter={.}...",
    "_check:types": "tsc --noEmit --project tsconfig.build.json",
    "lint": "eslint .",
    "check:exports": "turbo run _check:exports --filter={.}...",
    "_check:exports": "attw --pack .",
    "check:api": "turbo run _check:api --filter={.}...",
    "_check:api": "api-extractor run --local"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@restatedev/restate-sdk": "workspace:*",
    "@restatedev/restate-sdk-clients": "workspace:*",
    "@restatedev/restate-sdk-testcontainers": "workspace:*",
    "testcontainers": "^11.13.0"
  }
}
